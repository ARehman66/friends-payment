generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

/// App login identity. Admin (isAdmin) is owner-only — no Membership account balance.
model User {
  id           String   @id @default(cuid()) @map("_id")
  name         String
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  roleId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role             Role?          @relation(fields: [roleId], references: [id])
  memberships      Membership[]
  expensesRecorded Expense[]      @relation("ExpenseRecorder")
  expenseShares    ExpenseShare[]
  accountEntries   AccountEntry[]
}

model Role {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  description String   @default("")
  status      String   @default("active")
  /// [{ resourceKey, permissions: { all, view, add, edit, delete } }]
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Group {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  expenses       Expense[]
  accountEntries AccountEntry[]
}

/// Member in the office group + running account balance.
model Membership {
  id       String   @id @default(cuid()) @map("_id")
  groupId  String
  userId   String
  balance  Float    @default(0)
  active   Boolean  @default(true)
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

/// Expense total; equal shares cut from present members' accounts.
model Expense {
  id           String   @id @default(cuid()) @map("_id")
  groupId      String
  recordedById String   @map("paidById")
  amount       Float
  note         String   @default("")
  spentAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  createdById  String?

  group          Group          @relation(fields: [groupId], references: [id])
  recordedBy     User           @relation("ExpenseRecorder", fields: [recordedById], references: [id])
  shares         ExpenseShare[]
  accountEntries AccountEntry[]
}

/// Who was present on an expense and their equal share amount.
model ExpenseShare {
  id        String @id @default(cuid()) @map("_id")
  expenseId String
  userId    String
  share     Float

  expense Expense @relation(fields: [expenseId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

/// Account statement lines: ACCOUNT (credit) or EXPENSE (share cut).
model AccountEntry {
  id            String   @id @default(cuid()) @map("_id")
  groupId       String
  userId        String
  /// ACCOUNT | EXPENSE  (legacy rows may still be DEPOSIT | SHARE)
  type          String
  description   String
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  expenseId     String?
  createdAt     DateTime @default(now())

  group   Group    @relation(fields: [groupId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  expense Expense? @relation(fields: [expenseId], references: [id])

  @@index([groupId, userId, createdAt])
  @@index([groupId, createdAt])
}
